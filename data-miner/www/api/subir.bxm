<bx:script>
  // Sube uno o varios archivos (CSV, TSV, TXT, Excel, JSON o ZIP) y los carga como tablas de la sesión
  bx:header name="Content-Type" value="application/json";
  try {
    carpeta = getTempDirectory() & "dataminer/" & reReplace( session.sessionid, "[^A-Za-z0-9_-]", "_", "all" ) & "/subidas/"
    if ( !directoryExists( carpeta ) ) directoryCreate( carpeta )
    // accept "*": el filtro de formatos lo hacemos abajo. overwrite: volver a subir un archivo reemplaza su tabla
    subidos = fileUploadAll( destination: carpeta, accept: "*", nameConflict: "overwrite", strict: false )
    fuentes = new models.Fuentes( session.catalogo, carpeta )
    resultado = { tablas: [], errores: [] }
    for ( s in subidos ) {
      nombre = s.clientFile ?: s.serverFile
      ext = listLast( nombre, "." ).lCase()
      if ( !session.catalogo.formatos().append( "zip" ).findNoCase( ext ) ) {
        resultado.errores.append( "#nombre#: formato .#ext# no soportado" )
        if ( s.fileWasSaved ) fileDelete( s.serverDirectory & "/" & s.serverFile )
        continue
      }
      ruta = s.serverDirectory & "/" & s.serverFile
      r = fuentes.cargarArchivo( ruta, "subida:#nombre#" )
      if ( r.keyExists( "error" ) ) resultado.errores.append( "#nombre#: #r.error#" )
      else { resultado.tablas.append( r.tablas, true ); resultado.errores.append( r.errores, true ) }
    }
    // Diagnóstico inmediato (determinista, no necesita IA)
    ing = new models.IngenieroDatos( session.catalogo )
    nor = new models.Normalizacion( session.catalogo )
    resultado.calidad = resultado.tablas.map( t => {
      var d = ing.diagnosticar( t )
      var nz = nor.analizar( t, true )
      return { tabla: t, filas: d.filas, origen: d.origen, puntaje: d.puntaje_calidad, nivel: d.nivel, problemas: d.problemas, anonimizacion: d.origen.anonimizacion ?: [],
        normalizacion: { nivel: nz.nivel_normalizacion, clave: nz.clave_detectada, redundancia_pct: nz.redundancia_pct, hallazgos: nz.hallazgos } }
    } )
    // Hojas o archivos que son la misma tabla partida (por mes, sucursal...)
    resultado.partidas = nor.tablasPartidas().pares
    resultado.catalogo = session.catalogo.listar()
    resultado.anonimiza = session.catalogo.anonimiza()
    // Datos nuevos: el equipo empieza sin la memoria de misiones anteriores, para no mezclar contextos
    if ( resultado.tablas.len() ) structDelete( session, "equipo" )
    writeOutput( jsonSerialize( resultado ) )
  } catch ( any e ) {
    bx:header statusCode=500;
    writeOutput( jsonSerialize( { error: e.message } ) )
  }
</bx:script>
