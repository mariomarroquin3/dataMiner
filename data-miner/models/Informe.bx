/**
 * Acumula gráficas y genera un informe HTML autocontenido (Chart.js por CDN).
 */
class {

  property name="graficos";

  function init() {
    variables.graficos = []
    return this
  }

  /** { tipo: bar|line|scatter|pie|heatmap, titulo, labels, series:[{nombre,datos}] | puntos:[{x,y}] | matriz } */
  struct function agregarGrafico( required struct g ) {
    g.id = "g" & ( variables.graficos.len() + 1 )
    variables.graficos.append( g )
    return { ok: true, id: g.id, titulo: g.titulo ?: "" }
  }

  void function limpiar() { variables.graficos = [] }

  /** Gráfica a partir de un resultado SQL: x = columna de etiquetas, y = una o varias columnas numéricas */
  struct function desdeFilas( required array filas, required string tipo, required string x, required any y, string titulo = "" ) {
    if ( !filas.len() ) return { error: "La consulta no devolvió filas" }
    var ys = isArray( y ) ? y : listToArray( y )
    if ( tipo == "scatter" ) {
      return agregarGrafico( { tipo: "scatter", titulo: titulo, ejes: [ x, ys[ 1 ] ], puntos: filas.slice( 1, min( 500, filas.len() ) ).map( f => { return { x: f[ x ], y: f[ ys[ 1 ] ] } } ) } )
    }
    return agregarGrafico( {
      tipo  : tipo,
      titulo: titulo,
      labels: filas.map( f => f[ x ] ),
      series: ys.map( c => { return { nombre: c, datos: filas.map( f => f[ c ] ) } } )
    } )
  }

  /** Informe HTML completo */
  string function html( required struct reporte, string titulo = "Informe de datos" ) {
    var esc = ( s ) => encodeForHTML( toString( s ?: "" ) )
    var hechos = ( reporte.hechos ?: [] ).map( h => '<li class="#( h.verificado ?: false ) ? "ok" : "bad"#"><span class="tag">#( h.verificado ?: false ) ? "✓ Verificado" : "✗ No verificado"#</span>#esc( h.afirmacion )#<code>#esc( h.sql )#</code></li>' ).toList( "" )
    var nVer = ( reporte.hechos ?: [] ).filter( h => h.verificado ?: false ).len()
    var interp = ( reporte.interpretaciones ?: [] ).map( i => "<li>#esc( i )#</li>" ).toList( "" )
    var anon = ( reporte.anonimizacion ?: [] ).map( a => "<li><b>#esc( a.tabla )#.#esc( a.columna )#</b> · #esc( a.tipo )# → #esc( a.metodo )#</li>" ).toList( "" )
    var tablas = ( reporte.tablas ?: [] ).map( t => "<tr><td><b>#esc( t.tabla )#</b></td><td class=""num"">#t.filas#</td><td class=""mut"">#esc( t.fuente )#</td></tr>" ).toList( "" )
    var canvases = variables.graficos.map( g => g.tipo == "heatmap"
      ? '<div class="g wide"><h3>#esc( g.titulo )#</h3><div class="hmw">#heatmapHTML( g )#</div></div>'
      : '<div class="g"><h3>#esc( g.titulo )#</h3><div class="cv"><canvas id="#g.id#"></canvas></div></div>' ).toList( "" )
    var datos = jsonSerialize( variables.graficos.filter( g => g.tipo != "heatmap" ) )
    // Resumen ejecutivo: hasta 3 acciones con su impacto en dólares
    var monto = ( v ) => isNumeric( v ?: "" ) ? val( v ) : 0
    var todas = ( reporte.acciones ?: [] )
    var acciones = todas.len() > 3 ? todas.slice( 1, 3 ) : todas
    var impactoTotal = acciones.reduce( ( s, a ) => s + monto( a.impacto_usd ?: 0 ), 0 )
    var accionesHTML = acciones.map( ( a, i ) => '<li class="#( a.verificado ?: false ) ? "ok" : "bad"#"><span class="n">#i#</span><div class="ac"><b>#esc( a.accion )#</b>' &
      '<p>#esc( a.calculo ?: "" )#</p><span class="tag">#( a.verificado ?: false ) ? "✓ Cifra verificada" : "✗ Cifra sin verificar"#</span>' & ( len( a.plazo ?: "" ) ? '<span class="plazo">#esc( a.plazo )#</span>' : "" ) & '</div>' &
      '<div class="usd">#monto( a.impacto_usd ?: 0 ) ? "$" & numberFormat( monto( a.impacto_usd ?: 0 ), "9,999" ) : "—"#<small>impacto estimado</small></div></li>' ).toList( "" )
    return '<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>#esc( titulo )#</title>
#scriptChart()#
<style>
*{box-sizing:border-box}
body{margin:0;font:15px/1.55 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:##141a2e;background:##f6f7fb}
.pg{max-width:1040px;margin:0 auto;padding:0 20px 40px}
header{background:linear-gradient(135deg,##5b5bf0,##7c3aed);color:##fff;padding:28px 20px 64px}
header .in{max-width:1000px;margin:0 auto}
header small{opacity:.8;font-size:.8rem;letter-spacing:.06em;text-transform:uppercase}
header h1{margin:4px 0 4px;font-size:1.8rem;letter-spacing:-.02em}
header p{margin:0;opacity:.85;font-size:.85rem}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:-44px 0 20px}
.kpi{background:##fff;border:1px solid ##e4e7f0;border-radius:14px;padding:14px 16px;box-shadow:0 4px 16px rgba(20,26,46,.06)}
.kpi b{display:block;font-size:1.6rem;line-height:1.1}.kpi span{font-size:.75rem;color:##6b7390}
.kpi.ok b{color:##0f9f6e}.kpi.it b{color:##b7791f}.kpi.usd b{color:##5b5bf0}
.ejec{border-color:##d9d9fb;background:linear-gradient(180deg,##f7f7ff,##fff)}
ul.a li{display:flex;gap:14px;align-items:flex-start;border:1px solid ##e4e7f0;border-radius:12px;padding:14px;margin:0 0 10px;background:##fff}
ul.a li .n{flex:none;width:28px;height:28px;border-radius:50%;background:##5b5bf0;color:##fff;font-weight:700;display:grid;place-items:center;font-size:.85rem}
ul.a li .ac{flex:1;min-width:0}ul.a li .ac b{font-size:1rem}ul.a li .ac p{margin:4px 0 8px;color:##3d4560;font-size:.88rem}
ul.a li.bad .tag{background:##fdeceb;color:##d93a3a}
.plazo{display:inline-block;font-size:.7rem;padding:2px 8px;border-radius:6px;background:##eef0f7;color:##3d4560}
.usd{flex:none;text-align:right;font-size:1.35rem;font-weight:700;color:##5b5bf0;font-variant-numeric:tabular-nums}.usd small{display:block;font-size:.68rem;font-weight:400;color:##6b7390}
.sec{background:##fff;border:1px solid ##e4e7f0;border-radius:14px;padding:18px 20px;margin:0 0 16px;box-shadow:0 1px 2px rgba(20,26,46,.04)}
h2{margin:0 0 12px;font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:##6b7390}
.resumen{font-size:1.06rem;line-height:1.65;margin:0}
.mut{color:##6b7390}
ul{margin:0;padding:0;list-style:none}
ul.h li{border:1px solid ##e4e7f0;border-left:4px solid ##0f9f6e;border-radius:10px;padding:10px 12px;margin:0 0 10px;background:##fafbfd}
ul.h li.bad{border-left-color:##d93a3a}
.tag{display:inline-block;font-size:.66rem;font-weight:700;padding:2px 7px;border-radius:6px;margin-right:8px;background:##e6f7f0;color:##0f9f6e;text-transform:uppercase;letter-spacing:.04em}
li.bad .tag{background:##fdeceb;color:##d93a3a}
code{display:block;margin-top:8px;padding:8px 10px;border-radius:8px;background:##eef0f7;color:##3d4560;font:.76rem/1.45 ui-monospace,Consolas,monospace;white-space:pre-wrap;word-break:break-word}
ul.i li{border:1px solid ##e4e7f0;border-left:4px solid ##d99a2b;border-radius:10px;padding:10px 12px;margin:0 0 10px;background:##fffbf2}
ul.p li{padding:6px 0;border-bottom:1px solid ##e5f6f1;font-size:.9rem}ul.p li:last-child{border:0}
.priv{background:##e5f6f1;border-color:##bfe9dd}.priv h2{color:##0e7c66}
table.t{width:100%;border-collapse:collapse;font-size:.88rem}table.t td{padding:8px 6px;border-bottom:1px solid ##eef0f7}table.t tr:last-child td{border:0}
td.num{text-align:right;font-variant-numeric:tabular-nums}
.gs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.g{background:##fff;border:1px solid ##e4e7f0;border-radius:14px;padding:16px;box-shadow:0 1px 2px rgba(20,26,46,.04);min-width:0}
.g.wide,.gs .g:only-child{grid-column:1/-1}
.g h3{margin:0 0 10px;font-size:.95rem}
.cv{position:relative;height:300px}
.hmw{overflow:auto}
table.hm{border-collapse:separate;border-spacing:2px;font-size:.72rem}table.hm td,table.hm th{padding:5px 7px;text-align:center;border-radius:4px}table.hm th{color:##6b7390;font-weight:600}
footer{text-align:center;color:##6b7390;font-size:.78rem;margin-top:24px}
@media (max-width:720px){.kpis{grid-template-columns:repeat(2,1fr)}.gs{grid-template-columns:1fr}}
@media print{body{background:##fff}header{-webkit-print-color-adjust:exact;print-color-adjust:exact}.g,.sec{break-inside:avoid;box-shadow:none}}
</style></head><body>
<header><div class="in"><small>⛏ Data Miner · BoxLang AI</small><h1>#esc( titulo )#</h1><p>Generado el #dateTimeFormat( now(), "yyyy-MM-dd HH:mm" )#</p></div></header>
<div class="pg">
<div class="kpis">
<div class="kpi usd"><b>#impactoTotal ? "$" & numberFormat( impactoTotal, "9,999" ) : "—"#</b><span>impacto estimado de las acciones</span></div>
<div class="kpi"><b>#acciones.len()#</b><span>acciones recomendadas</span></div>
<div class="kpi ok"><b>#nVer#</b><span>hechos verificados</span></div>
<div class="kpi"><b>#( reporte.hechos ?: [] ).len() - nVer#</b><span>no verificados</span></div>
</div>
#len( accionesHTML ) ? "<div class=""sec ejec""><h2>Resumen ejecutivo · qué hacer</h2><ul class=""a"">#accionesHTML#</ul></div>" : ""#
<div class="sec"><h2>Resumen</h2><p class="resumen">#esc( reporte.respuesta ?: "" )#</p></div>
<div class="sec"><h2>Hechos verificados</h2><ul class="h">#hechos#</ul></div>
#len( interp ) ? "<div class=""sec""><h2>Interpretaciones</h2><ul class=""i"">#interp#</ul></div>" : ""#
#len( canvases ) ? "<h2 style=""margin:24px 0 12px"">Visualizaciones</h2><div class=""gs"">#canvases#</div>" : ""#
<div class="sec" style="margin-top:16px"><h2>Datos usados</h2><table class="t">#tablas#</table></div>
#len( anon ) ? "<div class=""sec priv""><h2>🔒 Privacidad</h2><p class=""mut"" style=""margin:0 0 8px"">Estos datos personales se anonimizaron antes de que los viera la IA. Los valores reales no salieron del servidor.</p><ul class=""p"">#anon#</ul></div>" : ""#
<footer>Cada hecho se comprobó re-ejecutando su SQL contra los datos · Data Miner</footer>
</div>
<script>
const G = #datos#;
const pal = ["##5b5bf0","##0f9f6e","##d99a2b","##d93a3a","##0891b2","##a855f7"];
const alfa = (c, a) => c + Math.round(a * 255).toString(16).padStart(2, "0");
Chart.defaults.font.family = "ui-sans-serif,system-ui,Segoe UI,Roboto,sans-serif";
Chart.defaults.color = "##6b7390";
Chart.defaults.borderColor = "##eef0f7";
Chart.defaults.maintainAspectRatio = false;
Chart.defaults.plugins.legend.labels.usePointStyle = true;
G.forEach(g => {
  const el = document.getElementById(g.id); if (!el) return;
  if (g.tipo === "scatter") {
    new Chart(el, { type: "scatter", data: { datasets: [{ label: (g.ejes||[]).join(" vs "), data: g.puntos, backgroundColor: alfa(pal[0], .7), pointRadius: 4 }] },
      options: { plugins: { legend: { display: false } }, scales: { x: { title: { display: true, text: (g.ejes||[])[0] } }, y: { title: { display: true, text: (g.ejes||[])[1] } } } } });
  } else {
    const pie = g.tipo === "pie", linea = g.tipo === "line";
    new Chart(el, { type: g.tipo, data: { labels: g.labels, datasets: (g.series||[]).map((s,i) => ({ label: s.nombre, data: s.datos,
        backgroundColor: pie ? pal : linea ? alfa(pal[i%6], .12) : pal[i%6], borderColor: pie ? "##fff" : pal[i%6],
        borderWidth: pie ? 2 : linea ? 2 : 0, borderRadius: g.tipo === "bar" ? 6 : 0, tension: .3, fill: linea && (g.series||[]).length === 1, pointRadius: linea ? 2 : 3 })) },
      options: { plugins: { legend: { display: pie || (g.series||[]).length > 1, position: "bottom" } }, scales: pie ? {} : { x: { grid: { display: false } }, y: { beginAtZero: true } } } });
  }
});
</script></body></html>'
  }

  /** Chart.js embebido (el informe funciona sin internet) o por CDN si no está el archivo local */
  private string function scriptChart() {
    var archivoJs = getDirectoryFromPath( getCurrentTemplatePath() ) & "../www/js/chart.umd.js"
    return fileExists( archivoJs )
      ? "<script>" & fileRead( archivoJs ) & "</script>"
      : '<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>'
  }

  private string function heatmapHTML( required struct g ) {
    var h = '<table class="hm"><tr><th></th>' & g.labels.map( l => "<th>#encodeForHTML( l )#</th>" ).toList( "" ) & "</tr>"
    g.matriz.each( ( fila, i ) => {
      h &= "<tr><th>#encodeForHTML( g.labels[ i ] )#</th>"
      fila.each( v => {
        var a = numberFormat( min( 1, abs( v ) ), "0.00" )
        var color = v >= 0 ? "rgba(79,70,229,#a#)" : "rgba(220,38,38,#a#)"
        h &= '<td style="background:#color#;color:#abs( v ) > 0.5 ? "##fff" : "##111"#">#numberFormat( v, "0.00" )#</td>'
      } )
      h &= "</tr>"
    } )
    return h & "</table>"
  }
}
