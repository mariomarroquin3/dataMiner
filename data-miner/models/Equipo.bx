/**
 * Equipo multiagente para analizar datos desconocidos. Dos modos con las mismas tools:
 *
 *   modo "compacto" (por defecto, gasta menos cuota del LLM):
 *     Coordinador ─┬─ Datos         (adquisición, perfilado, calidad, limpieza, esquema, consejos)
 *                  ├─ Analista      (SQL, base MCP, estadística, finanzas, gráficas)
 *                  └─ CientificoML  (regresiones, árbol y Random Forest con Tribuo; fuga de datos)
 *
 *   modo "completo": Coordinador + Adquisicion, Perfilador, IngenieroDatos, AnalistaCSV,
 *                    AnalistaDB (MCP), Estadistico, CientificoML
 *
 *   + Verificación automática: se re-ejecuta el SQL de cada hecho.
 *   + Gráficas e informe HTML descargable.
 */
class {

  property name="catalogo";
  property name="fuentes";
  property name="db";
  property name="coordinador";
  property name="informe";
  property name="estadistica";
  property name="ml";
  property name="ingeniero";
  property name="ultimoReporte";

  static {
    FORMATO = '
Responde SOLO con JSON válido:
{"respuesta": "resumen en español, 2-5 frases",
 "hechos": [{"afirmacion": "...", "sql": "consulta exacta que lo respalda", "origen": "csv o db"}],
 "interpretaciones": ["hipótesis o lectura de negocio"],
 "acciones": [{"accion": "qué debe hacer el gerente, en imperativo", "impacto_usd": 1234.5, "calculo": "cómo se estimó el impacto, con las cifras usadas", "sql": "consulta que respalda la cifra base", "origen": "csv o db", "plazo": "esta semana, este mes o este trimestre"}],
 "siguientes_preguntas": ["..."]}
Resumen ejecutivo: cierra con 1 a 3 acciones concretas para el gerente, de mayor a menor impacto. El impacto en dólares
(ventas recuperadas, costo evitado, cartera en riesgo, dinero inmovilizado) debe salir de cifras que entregaron las tools,
con su SQL; nunca inventes montos. Si no se puede expresar en dólares, pon impacto_usd en 0 y explícalo en calculo.'
  }

  /**
   * @modelo  Closure ( nombreAgente ) => AiModel. Permite usar un proveedor distinto por agente (o mock en pruebas)
   * @mcpUrl  URL HTTP de un servidor MCP con una base de datos (opcional)
   * @modo    "compacto" (coordinador + Datos, Analista, CientificoML) o "completo" (coordinador + 6-7 especialistas)
   */
  function init( required any catalogo, required any fuentes, required function modelo, string mcpUrl = "", string modo = "compacto" ) {
    variables.catalogo    = arguments.catalogo
    variables.fuentes     = arguments.fuentes
    variables.informe     = new Informe()
    variables.estadistica = new Estadistica( arguments.catalogo, variables.informe )
    variables.ml          = new ML( arguments.catalogo, variables.informe )
    variables.ingeniero   = new IngenieroDatos( arguments.catalogo, variables.informe )
    var cat = arguments.catalogo
    var fue = arguments.fuentes
    var inf = variables.informe
    var est = variables.estadistica
    var mlx = variables.ml
    var ing = variables.ingeniero
    variables.normalizacion = new Normalizacion( arguments.catalogo, variables.informe )
    variables.verificador   = new Verificador( arguments.catalogo )
    var nor = variables.normalizacion
    // Insights de negocio sin IA: tabla limpia + consultas fijas -> hechos verificables (ver models/Insights.bx)
    variables.insights = new Insights( arguments.catalogo, variables.informe )
    variables.hechosAuto = []
    var insx = variables.insights
    var autos = variables.hechosAuto

    // Reintenta con espera creciente si el proveedor responde 429 (límite por minuto del plan gratuito)
    // Solo reintenta el modelo, no las tools: reintentar un subagente repetía toda su conversación (ver ReintentoLLM.bx)
    var reintento = new ReintentoLLM( maxRetries: 4, initialDelay: 8000, backoffMultiplier: 2, maxDelay: 60000 )
    // Deja en logs/ai.log cada tool que usa cada agente (sirve para ver si un agente se queda en bucle)
    var bitacora = new bxModules.bxai.models.middleware.core.LoggingMiddleware( prefix: "[DataMiner]" )
    // Recorta los resultados de tools que se reenvían en cada llamada (Claude rechaza prompts de más de 1M tokens)
    var recorte = new RecorteContexto()
    // bx-ai corta a las 10 rondas de tools; los modelos Flash de Gemini piden una tool por ronda y una misión normal se pasa de 10
    var limites = { maxInteractions: 25 }

    var listar = aiTool( "listar_tablas", "Lista las tablas cargadas (nombre, filas, columnas, fuente)", () => cat.listar() )
    // Conocimiento de negocio (conocimiento/*.md): indicadores, cómo calcular el impacto en $ y acciones típicas por área
    var carpetaGuias = getDirectoryFromPath( getCurrentTemplatePath() ) & "../conocimiento/"
    var guia = aiTool( "guia_negocio",
      "Devuelve la guía de negocio de un área para interpretar los datos como consultor y estimar el impacto en dólares de las acciones. Áreas: ventas, inventario, cartera (créditos, cobros, mora), finanzas (márgenes, caja, gastos, precios)",
      ( area ) => {
        var archivo = carpetaGuias & reReplace( lCase( area ), "[^a-z]", "", "all" ) & ".md"
        return fileExists( archivo ) ? fileRead( archivo ) : "No hay guía para '#area#'. Áreas: ventas, inventario, cartera, finanzas"
      } ).describeArg( "area", "ventas, inventario, cartera o finanzas" )
    var graficar = aiTool( "graficar_sql", "Crea una gráfica para el informe a partir de un SELECT. tipo: bar, line, pie o scatter",
      ( tipo, sql, x, y, titulo ) => {
        var r = cat.consultar( sql )
        return r.keyExists( "error" ) && len( r.error ) ? r : inf.desdeFilas( r.resultado, tipo, x, y, titulo )
      } )
      .describeArg( "tipo", "bar | line | pie | scatter" )
      .describeArg( "sql", "SELECT que produce los datos" )
      .describeArg( "x", "Columna para el eje X / etiquetas" )
      .describeArg( "y", "Columna(s) numéricas separadas por coma" )
      .describeArg( "titulo", "Título de la gráfica" )

    // ---------------- Herramientas (las mismas en los dos modos)
    var t_adquisicion = [
          aiTool( "buscar_kaggle", "Busca datasets en Kaggle por tema", ( texto ) => fue.buscarKaggle( texto ) ).describeArg( "texto", "Tema a buscar" ),
          aiTool( "descargar_kaggle", "Descarga un dataset de Kaggle y carga sus CSV", ( ref ) => fue.descargarKaggle( ref ) ).describeArg( "ref", "Referencia owner/dataset" ),
          aiTool( "descargar_url", "Descarga un CSV, TSV, Excel (todas sus hojas), JSON o ZIP desde Google Drive (un archivo o una carpeta pública completa), Google Sheets o una URL pública", ( enlace ) => fue.descargarUrl( enlace ) ).describeArg( "enlace", "URL o link de compartir" ),
          listar
        ]
    var t_perfilador = [ listar, aiTool( "perfilar_tabla", "Perfil estadístico de una tabla", ( tabla ) => cat.perfilar( tabla ) ).describeArg( "tabla", "Nombre de la tabla" ) ]
    var insightsTool = aiTool( "insights_negocio", "Para una tabla de ventas o de inventario: arma una tabla limpia (montos de verdad, sin TOTAL ni duplicados, categorías unificadas) y devuelve hechos ya calculados y verificables: totales, ventas por sucursal, categoría, producto, vendedor, forma de pago y mes; o stock, agotados y dinero inmovilizado por sucursal. Úsala ANTES de escribir SQL propio", ( tabla ) => {
        var r = insx.generar( tabla )
        autos.append( r.hechos ?: [], true )
        return r
      } ).describeArg( "tabla", "Tabla de ventas o inventario" )
    var t_analistaCsv = [ listar, insightsTool, aiTool( "ejecutar_sql", "SELECT de solo lectura sobre las tablas cargadas", ( sql ) => cat.consultar( sql ) ).describeArg( "sql", "Consulta SELECT" ), graficar ]
    var t_estadistico = [
          listar,
          aiTool( "describir", "Estadística descriptiva (media, desviación, cuartiles, asimetría) de columnas numéricas", ( tabla, columnas ) => est.describir( tabla, columnas ) )
            .describeArg( "tabla", "Tabla" ).describeArg( "columnas", "Columnas separadas por coma; vacío = todas" ),
          aiTool( "correlacion", "Matriz de correlación y pares más fuertes (agrega un mapa de calor al informe)", ( tabla, columnas, metodo ) => est.correlacion( tabla, columnas, metodo ) )
            .describeArg( "tabla", "Tabla" ).describeArg( "columnas", "Columnas separadas por coma; vacío = todas las numéricas" ).describeArg( "metodo", "pearson o spearman" ),
          aiTool( "covarianza", "Matriz de covarianza", ( tabla, columnas ) => est.covarianza( tabla, columnas ) )
            .describeArg( "tabla", "Tabla" ).describeArg( "columnas", "Columnas separadas por coma" ),
          aiTool( "metricas_financieras", "Rendimiento, volatilidad anualizada, CAGR, Sharpe, max drawdown y VaR 95% de una serie de precios/valores",
            ( tabla, columnaValor, columnaFecha, periodosAnio ) => est.finanzas( tabla, columnaValor, columnaFecha ?: "", val( periodosAnio ?: 252 ) ) )
            .describeArg( "tabla", "Tabla" ).describeArg( "columnaValor", "Columna con el precio/valor" )
            .describeArg( "columnaFecha", "Columna de fecha para ordenar (opcional)" ).describeArg( "periodosAnio", "252 diario, 52 semanal, 12 mensual" ),
          graficar
        ]
    var t_cientifico = [
          listar,
          aiTool( "entrenar_modelo", "Entrena y evalúa un modelo (80/20). tipo: lineal, ridge, lasso, polinomial, logistica, arbol, random_forest",
            ( tabla, objetivo, tipo, features ) => mlx.entrenar( tabla, objetivo, tipo, features ?: "" ) )
            .describeArg( "tabla", "Tabla" ).describeArg( "objetivo", "Columna a predecir" )
            .describeArg( "tipo", "Tipo de modelo" ).describeArg( "features", "Columnas de entrada separadas por coma; vacío = todas" ),
          aiTool( "comparar_modelos", "Entrena varios modelos con el mismo objetivo y los rankea", ( tabla, objetivo, tipos, features ) => mlx.comparar( tabla, objetivo, tipos, features ?: "" ) )
            .describeArg( "tabla", "Tabla" ).describeArg( "objetivo", "Columna a predecir" )
            .describeArg( "tipos", "Tipos separados por coma, ej: lineal,lasso,random_forest" ).describeArg( "features", "Columnas de entrada; vacío = todas" ),
          aiTool( "predecir", "Predice con un modelo ya entrenado", ( nombreModelo, valoresJson ) => mlx.predecir( nombreModelo, isJSON( valoresJson ) ? jsonDeserialize( valoresJson ) : {} ) )
            .describeArg( "nombreModelo", "Nombre devuelto al entrenar (ej: random_forest_impago)" ).describeArg( "valoresJson", "JSON con columna: valor" )
        ]
    // Decisiones de operación: quiebre de stock y priorización de ventas (cálculo determinista)
    variables.operaciones = new Operaciones( cat, variables.informe, mlx )
    var ope = variables.operaciones
    t_estadistico.append( aiTool( "pronostico_stock", "Predice cuándo se agota cada producto (demanda reciente + tendencia), su punto de reorden, stock de seguridad y cuánto pedir. Guarda el resultado en la tabla pronostico_stock",
        ( tablaVentas, tablaInventario, nivelServicio, diasHistoria ) => ope.quiebreStock( tablaVentas, tablaInventario,
          ( isNumeric( diasHistoria ?: "" ) && diasHistoria > 0 ) ? diasHistoria : 56,
          ( isNumeric( nivelServicio ?: "" ) && nivelServicio > 0 ) ? nivelServicio : 0.95 ) )
      .describeArg( "tablaVentas", "Tabla de ventas con fecha, producto/SKU y unidades" )
      .describeArg( "tablaInventario", "Tabla con producto/SKU y stock actual (y días de entrega si hay)" )
      .describeArg( "nivelServicio", "0.90, 0.95 (por defecto), 0.975 o 0.99: protección contra quiebres" )
      .describeArg( "diasHistoria", "Días de historia para estimar la demanda (por defecto 56)" ) )
    variables.stockCuantiles = new StockCuantiles( arguments.catalogo, variables.informe )
    var stq = variables.stockCuantiles
    t_estadistico.append( aiTool( "pronostico_stock_cuantiles", "Pronóstico de quiebre de stock con regresión por cuantiles: demanda mediana (P50) y de un día malo (P90 o el nivel pedido) por producto, con tendencia, día de la semana y quincena. Da punto de reorden, días hasta agotar en escenario malo, cuánto pedir y qué tan calibrado está el modelo. Guarda la tabla pronostico_stock_cuantiles",
        ( tablaVentas, tablaInventario, nivelServicio ) => stq.pronosticoStock( tablaVentas, tablaInventario, isNumeric( nivelServicio ?: "" ) ? val( nivelServicio ) : 0.9 ) )
      .describeArg( "tablaVentas", "Ventas diarias (fecha, producto, unidades)" ).describeArg( "tablaInventario", "Stock actual por producto" ).describeArg( "nivelServicio", "Cuantil, por ejemplo 0.9 o 0.95 (opcional)" ) )
    t_cientifico.append( aiTool( "priorizar_ventas", "Ordena las oportunidades de venta abiertas por ganancia esperada: aprende la probabilidad de cierre de las ya ganadas/perdidas (regresión logística) y multiplica por monto y margen. Guarda el resultado en la tabla prioridad_ventas",
        ( tabla, top ) => ope.priorizarVentas( tabla, {}, ( isNumeric( top ?: "" ) && top > 0 ) ? top : 10 ) )
      .describeArg( "tabla", "Tabla de oportunidades con estado (ganada/perdida/abierta) y monto" )
      .describeArg( "top", "Cuántas oportunidades mostrar (por defecto 10)" ) )

    var t_ingeniero = [
          listar,
          aiTool( "diagnostico_calidad", "Diagnóstico de calidad: vacíos, duplicados, atípicos, categorías inconsistentes, fechas mezcladas, números como texto, IDs repetidos, datos personales. Devuelve un puntaje 0-100", ( tabla ) => ing.diagnosticar( tabla ) )
            .describeArg( "tabla", "Tabla" ),
          aiTool( "limpiar_tabla", "Crea <tabla>_limpia: quita espacios, unifica categorías, convierte montos y fechas, elimina duplicados", ( tabla ) => ing.limpiar( tabla ) )
            .describeArg( "tabla", "Tabla a limpiar" ),
          aiTool( "proponer_esquema", "Propone el CREATE TABLE (tipos, NOT NULL, clave primaria, CHECK) para llevar la tabla a una base de datos", ( tabla ) => ing.esquema( tabla ) )
            .describeArg( "tabla", "Tabla" ),
          aiTool( "detectar_fuga", "Detecta columnas que podrían filtrar la respuesta (data leakage) al predecir un objetivo", ( tabla, objetivo ) => ing.fugaDeDatos( tabla, objetivo ) )
            .describeArg( "tabla", "Tabla" ).describeArg( "objetivo", "Columna que se quiere predecir" ),
          aiTool( "consejos_recoleccion", "Recomendaciones para recolectar mejores datos, adaptadas a los problemas encontrados", ( tabla, objetivo ) => ing.consejos( tabla, objetivo ?: "" ) )
            .describeArg( "tabla", "Tabla" ).describeArg( "objetivo", "Columna a predecir en el futuro (opcional)" )
        ]
    // Normalización: al final para no mover t_ingeniero[ 5 ] (detectar_fuga), que usa CientificoML
    t_ingeniero.append( aiTool( "revisar_normalizacion", "Revisa si una tabla está normalizada: listas dentro de celdas, columnas repetidas (Producto_1..5, Meta_Q1..Q4), dependencias entre columnas (2FN/3FN), un mismo código con dos valores y nombres escritos de varias formas. Propone las tablas, la clave y el DDL", ( tabla ) => nor.analizar( tabla ) )
      .describeArg( "tabla", "Tabla" ) )
    t_ingeniero.append( aiTool( "normalizar_tabla", "Crea las tablas normalizadas (<tabla>_n_<entidad> y <tabla>_n_hechos) y devuelve el SELECT con JOIN que reconstruye la original", ( tabla ) => nor.normalizar( tabla ) )
      .describeArg( "tabla", "Tabla" ) )
    t_ingeniero.append( aiTool( "tablas_partidas", "Busca tablas que son la misma tabla partida en varias hojas o archivos (por mes, sucursal)", () => nor.tablasPartidas() ) )
    var t_db = []
    if ( len( arguments.mcpUrl ) ) {
      variables.db = new ConectorMCP( arguments.mcpUrl, cat )
      t_db = variables.db.tools()
    }
    // MySQL directo (JDBC). 3 tools: ver esquema (1 llamada), traer al catálogo, alerta de compras por Slack
    var mysql = new ConectorSQL()
    if ( mysql.configurado() ) {
      variables.alertaStock = new AlertaStock( cat, variables.informe )
      var al = variables.alertaStock
      t_db.append( aiTool( "mysql_esquema", "Tablas y columnas de la base MySQL de la empresa, en una sola llamada", () => mysql.esquema() ) )
      t_db.append( aiTool( "mysql_importar", "Trae una tabla de MySQL (o el resultado de un SELECT) a las tablas cargadas; después usa ejecutar_sql, pronostico_stock, etc. sobre la tabla mysql_<nombre>", ( origen ) => mysql.importar( cat, origen ) )
        .describeArg( "origen", "Nombre de la tabla o un SELECT" ) )
      t_db.append( aiTool( "alerta_stock", "Revisa en MySQL qué productos se van a acabar antes de que llegue un pedido nuevo, actualiza la tabla pronostico_stock en MySQL y, si enviar es true, avisa por Slack qué comprar", ( enviar ) => al.revisar( enviar ?: false ) )
        .describeArg( "enviar", "true para mandar el aviso a Slack" ) )
    }
    // Quita tools repetidas (listar_tablas y graficar_sql aparecen en varios grupos)
    var unir = ( listas ) => {
      var vistos = {}; var out = []
      listas.each( l => l.each( t => { if ( !vistos.keyExists( t.getName() ) ) { vistos[ t.getName() ] = true; out.append( t ) } } ) )
      return out
    }
    var equipo = []
    var plan = ""

    if ( arguments.modo == "completo" ) {
      // 1 coordinador + 6 o 7 especialistas: más vistoso, pero gasta ~29 llamadas al LLM por misión completa
      equipo.append( aiAgent( middleware: [ reintento, bitacora, recorte ], options: limites, name: "Adquisicion",
        description : "Busca y descarga datasets de Kaggle, Google Drive/Sheets o URLs y los carga como tablas",
        instructions: "Consigues datos. Si te dan un ref de Kaggle (owner/dataset) descárgalo; si te dan un tema, busca en Kaggle y elige el más relevante; si te dan un enlace, usa descargar_url. Termina listando las tablas cargadas.",
        model: modelo( "adquisicion" ), tools: t_adquisicion ) )
      equipo.append( aiAgent( middleware: [ reintento, bitacora, recorte ], options: limites, name: "Perfilador",
        description : "Analiza la estructura de tablas desconocidas: tipos, nulos, valores distintos, rangos y posibles claves",
        instructions: "Perfilas datos desconocidos. Para cada tabla relevante usa perfilar_tabla y explica qué representa cada columna, la calidad de los datos y qué preguntas de negocio permite responder.",
        model: modelo( "perfilador" ), tools: t_perfilador ) )
      equipo.append( aiAgent( middleware: [ reintento, bitacora, recorte ], options: limites, name: "AnalistaCSV",
        description : "Responde preguntas con SQL sobre las tablas descargadas (permite JOIN entre tablas)",
        instructions: "Sé eficiente: como máximo 6 consultas por encargo y respuestas cortas (cifras + SQL, sin repetir tablas completas). Si la tabla es de ventas o de inventario, llama primero insights_negocio: sus hechos ya vienen limpios y verificables; cítalos tal cual (con su SQL) y usa sus cifras para las acciones en vez de recalcular sobre la tabla cruda. Eres analista SQL. Solo SELECT. Toda cifra debe salir de ejecutar_sql; nunca inventes números. Devuelve las cifras junto con la consulta usada.",
        model: modelo( "analista_csv" ), tools: t_analistaCsv ) )
      equipo.append( aiAgent( middleware: [ reintento, bitacora, recorte ], options: limites, name: "Estadistico",
        description : "Estadística descriptiva, correlaciones (Pearson/Spearman), covarianza, métricas financieras (rendimiento, volatilidad, CAGR, Sharpe, drawdown, VaR) y pronóstico de quiebre de stock",
        instructions: "Eres estadístico y analista financiero. Usa las tools; nunca calcules a mano. Explica qué significa cada correlación (fuerte/moderada/débil, signo) y recuerda que correlación no implica causalidad. Para series de precios usa metricas_financieras. Para quiebres de stock y reabastecimiento usa pronostico_stock. Si preguntan por quiebre de stock, prefiere pronostico_stock_cuantiles (cita pronostico_stock_cuantiles en el SQL de los hechos) y menciona la calibración que devuelve.",
        model: modelo( "estadistico" ), tools: t_estadistico ) )
      equipo.append( aiAgent( middleware: [ reintento, bitacora, recorte ], options: limites, name: "CientificoML",
        description : "Entrena y compara modelos de ML tabular (regresión lineal, ridge, lasso, polinomial, logística, árbol, Random Forest), predice con ellos y prioriza oportunidades de venta por ganancia esperada",
        instructions: "Eres científico de datos. Para predecir un número usa regresiones (lineal, ridge, lasso, polinomial) y random_forest; para una categoría usa logistica, arbol o random_forest. Prefiere comparar_modelos. Reporta métricas de test (R², RMSE, MAE o accuracy, F1, AUC) y compara contra la línea base. Explica las variables más importantes. Advierte si el modelo es débil. Si preguntan qué ventas, clientes u oportunidades priorizar, usa priorizar_ventas y cita su tabla prioridad_ventas en el SQL de los hechos.",
        model: modelo( "cientifico_ml" ), tools: t_cientifico ) )
      equipo.append( aiAgent( middleware: [ reintento, bitacora, recorte ], options: limites, name: "IngenieroDatos",
        description : "Ingeniero de datos: diagnostica la calidad, limpia tablas, propone el esquema SQL, detecta fuga de datos para ML y aconseja cómo recolectar mejores datos",
      instructions: "Eres ingeniero de datos senior. Usa las tools y explica en lenguaje simple. Principios que aplicas:
- Calidad: completitud (vacíos), unicidad (IDs y duplicados), validez (rangos, tipos, valores imposibles), consistencia (categorías y formatos de fecha), oportunidad (fecha de captura).
- Recolección: validar en el punto de captura (listas desplegables, rangos, obligatorios); un ID único generado por el sistema; fechas ISO 8601; unidades y moneda explícitas; diccionario de datos; guardar crudo y transformar en capas (raw -> limpia -> analítica); preferir una base de datos o formularios a Excel por correo; registrar quién y cuándo capturó.
- Excel: una tabla por hoja, encabezados en una sola fila, sin celdas combinadas ni totales dentro de los datos.
- ML: el objetivo y las variables deben capturarse en el momento correcto (evitar fuga de datos); suficientes casos por clase; incluir casos rechazados.
- Privacidad: minimizar datos personales, consentimiento, anonimizar.
Si te piden limpiar, usa limpiar_tabla y avisa el nombre de la tabla limpia para que los demás la usen. Ordena las recomendaciones por impacto. Si el Excel tiene varias hojas o piden diseño de base de datos, normalización o por qué no cuadran los totales, usa revisar_normalizacion y tablas_partidas; si piden la versión normalizada, normalizar_tabla y avisa los nombres de las tablas _n_.",
        instructions: "Eres ingeniero de datos senior. Usa las tools y explica en lenguaje simple. Principios que aplicas:
- Calidad: completitud (vacíos), unicidad (IDs y duplicados), validez (rangos, tipos, valores imposibles), consistencia (categorías y formatos de fecha), oportunidad (fecha de captura).
- Recolección: validar en el punto de captura (listas desplegables, rangos, obligatorios); un ID único generado por el sistema; fechas ISO 8601; unidades y moneda explícitas; diccionario de datos; guardar crudo y transformar en capas (raw -> limpia -> analítica); preferir una base de datos o formularios a Excel por correo; registrar quién y cuándo capturó.
- Excel: una tabla por hoja, encabezados en una sola fila, sin celdas combinadas ni totales dentro de los datos.
- ML: el objetivo y las variables deben capturarse en el momento correcto (evitar fuga de datos); suficientes casos por clase; incluir casos rechazados.
- Privacidad: minimizar datos personales, consentimiento, anonimizar.
Si te piden limpiar, usa limpiar_tabla y avisa el nombre de la tabla limpia para que los demás la usen. Ordena las recomendaciones por impacto. Si el Excel tiene varias hojas o piden diseño de base de datos, normalización o por qué no cuadran los totales, usa revisar_normalizacion y tablas_partidas; si piden la versión normalizada, normalizar_tabla y avisa los nombres de las tablas _n_.",
        model: modelo( "ingeniero_datos" ), tools: t_ingeniero ) )
      if ( t_db.len() ) {
        equipo.append( aiAgent( middleware: [ reintento, bitacora, recorte ], options: limites, name: "AnalistaDB",
          description : "Explora y consulta la base de datos remota conectada por MCP",
          instructions: "Exploras una base de datos desconocida vía MCP: primero lista tablas, luego describe las relevantes, luego consulta. Solo SELECT. Devuelve cifras con la consulta usada. Si hay tools mysql_*: para preguntas de la base de la empresa usa mysql_esquema una vez y luego mysql_importar solo las tablas necesarias. Si preguntan qué comprar o cuándo se acaba el stock en la base, usa alerta_stock (enviar=true solo si piden avisar por Slack) y cita la tabla pronostico_stock.",
          model: modelo( "analista_db" ), tools: t_db ) )
      }
      plan = "1) si faltan datos, delega a Adquisicion; 2) delega a Perfilador para entender las tablas y a IngenieroDatos para revisar su calidad (si la calidad es mala pide limpiar y usa la tabla _limpia; si piden consejos de recolección, esquema o hay un objetivo de ML, también a IngenieroDatos); 3) delega preguntas a AnalistaCSV y/o AnalistaDB; 4) para relaciones entre variables o finanzas delega a Estadistico; 5) para predecir o explicar una variable, o priorizar ventas, delega a CientificoML; para quiebre de stock y reabastecimiento, a Estadistico; 6) pide al menos una gráfica; 7) integra los resultados."
    } else {
      // Modo compacto (por defecto): 1 coordinador + 3 especialistas con las mismas tools. Gasta menos cuota del LLM
      equipo.append( aiAgent( middleware: [ reintento, bitacora, recorte ], options: limites, name: "Datos",
        description : "Consigue, carga y entiende los datos: Kaggle, Drive/Sheets, URLs; perfila tablas; diagnostica y limpia la calidad; propone esquema SQL; detecta fuga de datos; aconseja cómo recolectar mejor",
        instructions: "Eres ingeniero de datos. Pasos: 1) si faltan datos, consíguelos (Kaggle por tema o ref, o descargar_url para enlaces); 2) perfila las tablas relevantes; 3) usa diagnostico_calidad y, si el puntaje es menor a 60, limpiar_tabla y avisa el nombre de la tabla _limpia; 4) si piden esquema, fuga de datos o consejos de recolección, usa esas tools. Explica en lenguaje simple qué representa cada tabla, su calidad y qué preguntas permite responder. Principios: " & "Eres ingeniero de datos senior. Usa las tools y explica en lenguaje simple. Principios que aplicas:
- Calidad: completitud (vacíos), unicidad (IDs y duplicados), validez (rangos, tipos, valores imposibles), consistencia (categorías y formatos de fecha), oportunidad (fecha de captura).
- Recolección: validar en el punto de captura (listas desplegables, rangos, obligatorios); un ID único generado por el sistema; fechas ISO 8601; unidades y moneda explícitas; diccionario de datos; guardar crudo y transformar en capas (raw -> limpia -> analítica); preferir una base de datos o formularios a Excel por correo; registrar quién y cuándo capturó.
- Excel: una tabla por hoja, encabezados en una sola fila, sin celdas combinadas ni totales dentro de los datos.
- ML: el objetivo y las variables deben capturarse en el momento correcto (evitar fuga de datos); suficientes casos por clase; incluir casos rechazados.
- Privacidad: minimizar datos personales, consentimiento, anonimizar.
Si te piden limpiar, usa limpiar_tabla y avisa el nombre de la tabla limpia para que los demás la usen. Ordena las recomendaciones por impacto. Si el Excel tiene varias hojas o piden diseño de base de datos, normalización o por qué no cuadran los totales, usa revisar_normalizacion y tablas_partidas; si piden la versión normalizada, normalizar_tabla y avisa los nombres de las tablas _n_.",
        model: modelo( "datos" ), tools: unir( [ t_adquisicion, t_perfilador, t_ingeniero ] ) ) )
      equipo.append( aiAgent( middleware: [ reintento, bitacora, recorte ], options: limites, name: "Analista",
        description : "Responde preguntas con SQL (tablas cargadas y, si hay, la base remota vía MCP), estadística descriptiva, correlaciones, covarianza, métricas financieras, pronóstico de quiebre de stock y gráficas",
        instructions: "Sé eficiente: como máximo 6 consultas por encargo y respuestas cortas (cifras + SQL, sin repetir tablas completas). Si la tabla es de ventas o de inventario, llama primero insights_negocio: sus hechos ya vienen limpios y verificables; cítalos tal cual (con su SQL) y usa sus cifras para las acciones en vez de recalcular sobre la tabla cruda. Eres analista de datos y estadístico. Solo SELECT; toda cifra debe salir de una tool, nunca calcules a mano ni inventes números. Para la base remota usa las tools db_*. Si hay tools mysql_*: para preguntas de la base de la empresa usa mysql_esquema una vez y luego mysql_importar solo las tablas necesarias. Si preguntan qué comprar o cuándo se acaba el stock en la base, usa alerta_stock (enviar=true solo si piden avisar por Slack) y cita la tabla pronostico_stock. Si preguntan cuándo se acaba el stock, qué reabastecer o cuánto pedir, usa pronostico_stock y cita su tabla pronostico_stock en el SQL de los hechos. Si preguntan por quiebre de stock, prefiere pronostico_stock_cuantiles (cita pronostico_stock_cuantiles en el SQL de los hechos) y menciona la calibración que devuelve. Para relaciones entre variables usa correlacion (explica fuerza y signo; correlación no implica causalidad); para series de precios o caja usa metricas_financieras. Crea al menos una gráfica. Devuelve las cifras junto con la consulta usada.",
        model: modelo( "analista" ), tools: unir( [ t_analistaCsv, t_estadistico, t_db, [ guia ] ] ) ) )
      equipo.append( aiAgent( middleware: [ reintento, bitacora, recorte ], options: limites, name: "CientificoML",
        description : "Entrena y compara modelos de ML tabular (regresión lineal, ridge, lasso, polinomial, logística, árbol, Random Forest), predice con ellos y prioriza oportunidades de venta por ganancia esperada",
        instructions: "Eres científico de datos. Para predecir un número usa regresiones (lineal, ridge, lasso, polinomial) y random_forest; para una categoría usa logistica, arbol o random_forest. Prefiere comparar_modelos. Reporta métricas de test (R², RMSE, MAE o accuracy, F1, AUC) y compara contra la línea base. Explica las variables más importantes. Advierte si el modelo es débil. Si preguntan qué ventas, clientes u oportunidades priorizar, usa priorizar_ventas y cita su tabla prioridad_ventas en el SQL de los hechos." & " Antes de entrenar, usa detectar_fuga si hay dudas sobre alguna columna.",
        model: modelo( "cientifico_ml" ), tools: unir( [ t_cientifico, [ t_ingeniero[ 5 ] ] ] ) ) )
      plan = "1) delega a Datos para conseguir (si faltan), entender y revisar la calidad de los datos; si crea una tabla _limpia, úsala en adelante; 2) delega preguntas, estadística, finanzas y gráficas a Analista; 3) para predecir o explicar una variable, o para priorizar ventas u oportunidades, delega a CientificoML; el pronóstico de stock y reabastecimiento va a Analista; 4) integra los resultados. Delega solo lo necesario para la pregunta: cada delegación consume cuota del modelo."
    }

    variables.coordinador = aiAgent(
      middleware  : [ reintento, bitacora, recorte ],
      options     : limites,
      name        : "Coordinador",
      description : "Coordina el equipo de datos",
      instructions: "Coordinas un equipo de análisis de datos desconocidos. Plan: " & plan & " Separa hechos (con su SQL) de interpretaciones. Privacidad: los datos personales ya llegan anonimizados (pseudónimos como DUI_1a2b3c4d o Persona_…, direcciones reducidas al departamento, edades en rangos). Úsalos como identificadores, nunca intentes reidentificar a nadie y no pidas los valores reales." &
        " Datos: usa primero las tablas que el usuario subió o descargó (en listar_tablas tienen ejemplo=false); las de ejemplo (ejemplo=true: creditos, precios, clientes_sv_*, operaciones_sv_*) úsalas solo si el pedido las nombra." &
        " Honestidad: nunca digas que se ejecutó un análisis, modelo o cálculo que ninguna tool hizo en esta misión. Si piden una técnica que el equipo no tiene (por ejemplo una regresión por cuantiles fuera del pronóstico de stock), dilo claro y ofrece la más cercana que sí existe." &
        " Delega solo lo necesario: normalmente 1 encargo a Datos y 1 al Analista; no repitas encargos ni pidas revisar todas las tablas si el pedido no lo exige." &
        " Para tablas de ventas o inventario pide al analista que use insights_negocio: los hechos importantes salen de ahí, ya verificados." &
        " Hablas con el gerente de una empresa: antes de proponer las acciones, consulta una vez guia_negocio del área que corresponda (ventas, inventario, cartera o finanzas) y estima el impacto como dice la guía, pidiendo al equipo las cifras que falten." & static.FORMATO,
      model       : modelo( "coordinador" ),
      tools       : [ listar, guia ],
      subAgents   : equipo,
      memory      : aiMemory( memory: "window", config: { maxMessages: 40 } )
    )
    // Structured output nativo de bx-ai: un modelo SIN tools que devuelve el reporte con un esquema fijo.
    // Va en un paso aparte porque con algunos proveedores la salida estructurada choca con el tool calling.
    variables.esquema = { respuesta: "", hechos: [ { afirmacion: "", sql: "", origen: "" } ], interpretaciones: [ "" ],
      acciones: [ { accion: "", impacto_usd: 0, calculo: "", sql: "", origen: "", plazo: "" } ], siguientes_preguntas: [ "" ] }
    variables.formateador = modelo( "formateador" ).structuredOutput( variables.esquema )
    // Plan B sin structured output: algunos modelos (p. ej. de Claude) no aceptan el tool_choice forzado que usa bx-ai
    variables.formateadorTexto = modelo( "formateador" )
    variables.sinStructured = false

    // Pipeline de BoxLang AI: coordinador (con sus subagentes) → structured output → verificar cada hecho
    variables.flujo = variables.coordinador
      .transform( ( texto ) => estructurar( texto ) )
      .transform( ( reporte ) => {
        // ¿El equipo analizó algo en esta misión? (sin contar descargas ni la verificación que viene después)
        var hechasAhora = variables.catalogo.getConsultas().len() - ( variables.antesMision ?: 0 )
        var analisis = hechasAhora > 0
          ? variables.catalogo.getConsultas().slice( ( variables.antesMision ?: 0 ) + 1, hechasAhora ).filter( c => !toString( c.sql ?: "" ).reFindNoCase( "^descarga\(" ) ).len()
          : 0
        // Los hechos de insights_negocio entran siempre, aunque el modelo no los copie (sin repetir SQL)
        var propios = ( reporte.hechos ?: [] ).filter( h => isStruct( h ) )
        var autosNuevos = variables.hechosAuto.filter( a => !propios.some( h => trim( h.sql ?: "" ) == trim( a.sql ) ) ).map( a => duplicate( a ) )
        reporte.hechos = autosNuevos.append( propios, true )
        verificarReporte( reporte )
        // Si alguna cifra no sale del SQL (en hechos, acciones o montos del resumen), una pasada de corrección
        // reescribe el reporte con los valores verificados y recalcula los impactos sobre ellos
        if ( analisis ) {
          var problemas = cifrasMalas( reporte )
          if ( problemas.len() ) reporte = corregir( reporte, problemas )
        }
        if ( !analisis && ( reporte.hechos.len() || reporte.acciones.len() ) ) {
          // El modelo respondió sin usar ninguna tool de análisis: lo que diga no está respaldado por los datos
          reporte.advertencia = "El equipo no ejecutó ningún análisis en esta misión: la respuesta no está respaldada por los datos. Repite el pedido nombrando la tabla."
          reporte.acciones = reporte.acciones.map( a => a.append( { verificado: false, nota: "Sin análisis en esta misión" } ) )
        }
        return reporte;
      } )
    return this
  }

  /** Ejecuta una misión completa (vía el pipeline) y devuelve reporte + evidencia + verificación */
  struct function mision( required string pedido, struct options = {} ) {
    var antes = variables.catalogo.getConsultas().len()
    variables.antesMision = antes
    variables.hechosAuto.clear()
    variables.informe.limpiar()
    variables.verificador.reiniciar()
    var reporte = variables.flujo.run( pedido, {}, options )
    reporte.cadena = variables.verificador.verificarCadena()
    var total = variables.catalogo.getConsultas().len()
    reporte.evidencia = total > antes ? variables.catalogo.getConsultas().slice( antes + 1, total - antes ) : []
    reporte.tablas = variables.catalogo.listar()
    reporte.anonimizacion = variables.catalogo.informeAnonimizacion()
    reporte.graficos = variables.informe.getGraficos()
    variables.ultimoReporte = reporte
    return reporte
  }

  /** Informe HTML autocontenido de la última misión */
  string function informeHTML( string titulo = "Informe Data Miner" ) {
    return variables.informe.html( variables.ultimoReporte ?: {}, titulo )
  }

  /**
   * Re-ejecuta el SQL de un hecho. Con estricto, además compara las cifras de la afirmación con el resultado
   * (Verificador.contrastar) y sella el hecho en la cadena de bloques. Las acciones del resumen ejecutivo
   * no son estrictas: su impacto se calcula a partir de la cifra base, no la repite.
   */
  private struct function verificar( required struct hecho, boolean estricto = true ) {
    if ( !len( hecho.sql ?: "" ) ) return hecho.append( { verificado: false, nota: "Sin SQL" } )
    var r = ( ( hecho.origen ?: "csv" ) == "db" && !isNull( variables.db ) ) ? variables.db.consultar( hecho.sql ) : variables.catalogo.consultar( hecho.sql )
    var ok = !len( r.error ?: "" ) && ( ( r.filas ?: 1 ) > 0 )
    if ( !ok ) return hecho.append( { verificado: false, nota: r.error ?: "Sin filas" } )
    if ( !isNull( variables.resultadosSql ) ) variables.resultadosSql[ hecho.sql ] = r
    if ( !arguments.estricto ) return hecho.append( { verificado: true, nota: "SQL re-ejecutado correctamente" } )
    var c = variables.verificador.contrastar( hecho, r )
    hecho.append( { verificado: c.estado != "no_coincide", cifras: c.estado, nota: c.estado == "no_coincide" ? "⚠ " & c.nota : "SQL re-ejecutado. " & c.nota } )
    hecho.bloque = variables.verificador.sellar( hecho, r )
    return hecho
  }

  /**
   * Acción del resumen ejecutivo: su SQL tiene que correr y las cifras base que cita en "calculo"
   * tienen que salir de ese SQL. El monto de impacto es una estimación y no se contrasta.
   */
  private struct function verificarAccion( required struct accion ) {
    verificar( accion, false )
    if ( !accion.verificado ) return accion
    var c = variables.verificador.contrastar( { afirmacion: accion.calculo ?: "", sql: accion.sql } )
    // "calculo" mezcla la cifra base con porcentajes y supuestos derivados: basta con que la cifra base salga del SQL
    var alguna = ( c.cifras ?: [] ).some( x => x.coincide )
    if ( c.estado == "no_coincide" && !alguna ) return accion.append( { verificado: false, nota: "⚠ Ninguna cifra del cálculo sale del SQL. " & c.nota } )
    return accion.append( { nota: c.estado == "sin_cifra" ? "SQL re-ejecutado (el cálculo no trae cifras que contrastar)" : "Cifra base verificada con el SQL" } )
  }

  /** Verifica hechos (estricto) y acciones; guarda los resultados SQL para la corrección */
  private void function verificarReporte( required struct reporte ) {
    variables.resultadosSql = {}
    reporte.hechos = ( reporte.hechos ?: [] ).filter( h => isStruct( h ) ).map( h => verificar( h ) )
    // Las acciones del resumen ejecutivo también se verifican: su cifra base debe salir de un SQL que corre
    reporte.acciones = ( reporte.acciones ?: [] ).filter( a => isStruct( a ) && len( a.accion ?: "" ) ).map( a => verificarAccion( a ) )
  }

  /** Lista de problemas: hechos con cifras que no coinciden, acciones sin cifra base y montos del resumen sin respaldo */
  private array function cifrasMalas( required struct reporte ) {
    var out = []
    reporte.hechos.filter( h => ( h.cifras ?: "" ) == "no_coincide" ).each( h => out.append( "Hecho «#h.afirmacion#»: #h.nota#" ) )
    reporte.acciones.filter( a => !( a.verificado ?: false ) && ( a.nota ?: "" ).find( "Ninguna cifra" ) ).each( a => out.append( "Acción «#a.accion#»: #a.nota#" ) )
    var valores = []
    variables.resultadosSql.each( ( sql, r ) => valores.append( variables.verificador.valoresDe( r ), true ) )
    var sueltas = variables.verificador.cifrasSinRespaldo( reporte.respuesta ?: "", valores )
    if ( sueltas.len() ) out.append( "Montos del resumen que no salen de ningún SQL: #sueltas.toList( ', ' )#" )
    return out
  }

  /**
   * Una sola pasada de corrección (1 llamada al modelo, sin tools): recibe los resultados SQL reales y reescribe
   * el resumen, los hechos y las acciones con esas cifras. Después se vuelve a verificar todo.
   */
  private struct function corregir( required struct reporte, required array problemas ) {
    var evidencia = []
    variables.resultadosSql.each( ( sql, r ) => evidencia.append( { sql: sql, resultado: ( r.resultado ?: [] ).len() > 25 ? r.resultado.slice( 1, 25 ) : ( r.resultado ?: [] ) } ) )
    var original = reporte.filter( ( k, v ) => [ "respuesta", "hechos", "interpretaciones", "acciones", "siguientes_preguntas" ].findNoCase( k ) )
    try {
      var nuevo = formatear(
        "Eres el editor final de un reporte de datos. Estas cifras del reporte NO coinciden con lo que devuelven sus SQL:" & char( 10 ) &
        problemas.toList( char( 10 ) ) & char( 10 ) & char( 10 ) &
        "Resultados SQL reales (la única fuente válida de cifras):" & char( 10 ) & jsonSerialize( evidencia ) & char( 10 ) & char( 10 ) &
        "Reescribe el reporte usando SOLO cifras de esos resultados: corrige la respuesta, cada afirmación y el calculo de cada acción, " &
        "y recalcula impacto_usd con la misma regla pero sobre el valor verificado (por ejemplo, si era 20% de una cifra falsa, ahora es 20% de la real). " &
        "Copia cada SQL exactamente igual. Si una cifra no aparece en ningún resultado, quítala. Reporte original:" & char( 10 ) & jsonSerialize( original ) )
      if ( !isStruct( nuevo ) || !isArray( nuevo.hechos ?: "" ) ) return reporte.append( { correccion: "No se pudo corregir: revisa las cifras marcadas" } )
      variables.verificador.reiniciar()
      verificarReporte( nuevo )
      var quedan = cifrasMalas( nuevo )
      return reporte.append( nuevo ).append( {
        correccion: "Se corrigieron cifras que no salían del SQL (#problemas.len()# problema(s))" & ( quedan.len() ? "; quedan #quedan.len()# sin respaldo" : "" ),
        correccion_detalle: problemas
      } )
    } catch ( any e ) {
      // si falló a mitad de camino la cadena quedó a medias: se vuelve a sellar el reporte original
      try { variables.verificador.reiniciar(); verificarReporte( reporte ) } catch ( any e2 ) {}
      return reporte.append( { correccion: "No se pudo corregir (#e.message#): revisa las cifras marcadas" } )
    }
  }

  /** Para el endpoint que vuelve a comprobar la cadena de hechos sellados */
  any function getVerificador() { return variables.verificador }

  /**
   * Convierte la respuesta del coordinador al esquema con structured output (1 llamada extra, sin tools).
   * Si el proveedor no lo soporta o falla, cae a parsear() para no perder la misión.
   */
  private struct function estructurar( required any texto ) {
    try {
      var r = formatear( "Convierte este reporte al esquema pedido. Copia cada SQL exactamente como está, " &
        "no inventes hechos ni acciones nuevas, copia los montos de impacto tal cual y deja en interpretaciones lo que no tenga SQL. Reporte:" & char( 10 ) & toString( texto ) )
      if ( isStruct( r ) && r.keyExists( "hechos" ) && isArray( r.hechos ) ) return r.append( { formato: variables.sinStructured ? "JSON por texto" : "structured output" } )
    } catch ( any e ) {
      return parsear( texto ).append( { formato: "parseo de texto (structured output falló: #e.message#)" } )
    }
    return parsear( texto ).append( { formato: "parseo de texto" } )
  }

  /**
   * Llama al formateador con structured output; si el modelo no lo soporta (Claude responde
   * "tool_choice ... not supported for this model"), pasa a pedir el JSON por texto y lo parsea.
   */
  private any function formatear( required string prompt ) {
    if ( !variables.sinStructured ) {
      try {
        return variables.formateador.run( prompt )
      } catch ( any e ) {
        if ( !e.message.reFindNoCase( "tool_choice|structured|response_format" ) ) rethrow;
        variables.sinStructured = true
      }
    }
    return parsear( variables.formateadorTexto.run( prompt & char( 10 ) & static.FORMATO ) )
  }

  private struct function parsear( required any texto ) {
    var limpio = toString( texto ).reReplace( "(?s)^.*?```(?:json)?\s*", "" ).reReplace( "(?s)```.*$", "" ).trim()
    if ( isJSON( limpio ) && isStruct( jsonDeserialize( limpio ) ) ) return jsonDeserialize( limpio )
    return { respuesta: toString( texto ), hechos: [], interpretaciones: [], acciones: [], siguientes_preguntas: [] }
  }
}
